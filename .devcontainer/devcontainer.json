{
	"name": "EbMS 2.21",
	"image": "mcr.microsoft.com/devcontainers/base:noble",
	"mounts": [
		// mkdir ~/.openhands.ebms ~/.pochi.ebms
		"type=bind,source=${localEnv:HOME}${localEnv:USERPROFILE}/.openhands.ebms/,target=/home/vscode/.openhands",
		"type=bind,source=${localEnv:HOME}${localEnv:USERPROFILE}/.pochi.ebms/,target=/home/vscode/.pochi",
		"type=bind,source=${localEnv:HOME}${localEnv:USERPROFILE}/.ssh/,target=/home/vscode/.ssh,readonly"
	],
	"features": {
		"ghcr.io/devcontainers/features/docker-in-docker:4.1.1": {},
		"ghcr.io/devcontainers/features/node:2.1.0": {},
		"ghcr.io/devcontainers/features/java:1.8.3": {
			"installMaven": true,
			"version": "21",
			"jdkDistro": "tem"
		},
		"ghcr.io/devcontainers-extra/features/apt-packages:1": {
			"packages": [
				"libxtst6",
				"libxi6",
				"libxrender1",
				"graphviz",
				"tmux"
			]
		}
		// "ghcr.io/coder/devcontainer-features/code-server:2": {
		// 	"port": "7001",
		// 	"host": "0.0.0.0",
		// 	"auth": "none",
		// 	"disableTelemetry": true,
		// 	"extensions": "tabbyml.pochi,ms-azuretools.vscode-docker,donjayamanne.githistory,mhutchie.git-graph,humao.rest-client,qcz.text-power-tools,jebbs.plantuml,tomoyukim.vscode-mermaid-editor,dbaeumer.vscode-eslint,vscjava.vscode-java-pack,sonarsource.sonarlint-vscode,redhat.fabric8-analytics,microsoft.cursor-pgsql,github.vscode-github-actions"
		// }
	},
	"containerUser": "vscode",
	"remoteUser": "vscode",
	"postCreateCommand": "curl -LsSf https://astral.sh/uv/install.sh | sh && npm install -g @openhands/agent-canvas",
	"postStartCommand": "tmux has-session -t canvas 2>/dev/null || (tmux new-session -d -s canvas && tmux send-keys -t canvas 'agent-canvas --port 7000' Enter)",
	"appPort": [
		"7000:7000"
		// "7001:7001"
	],
	"forwardPorts": [
		5432,
		7000,
		8000,
		8080,
		8088,
		8443
	],
	"customizations": {
		"vscode": {
			"settings": {
				"java.configuration.updateBuildConfiguration": "automatic",
				"java.compile.nullAnalysis.mode": "automatic",
				"markdown.extension.toc.updateOnSave": false,
				"sonarlint.ls.javaHome": "/usr/local/sdkman/candidates/java/21.0.7-tem/",
				"sonarlint.rules": {
					"java:S106": {
						"level": "off"
					},
					"java:S107": {
						"level": "off"
					},
					"java:S110": {
						"level": "off"
					},
					"java:S125": {
						"level": "off"
					},
					"java:S1134": {
						"level": "off"
					},
					"java:S1135": {
						"level": "off"
					},
					"java:S1192": {
						"level": "off"
					}
				}
			},
			"extensions": [
				"tabbyml.pochi",
				// "ms-azuretools.vscode-docker",
				"donjayamanne.githistory",
				"mhutchie.git-graph",
				"humao.rest-client",
				"qcz.text-power-tools",
				"jebbs.plantuml",
				"tomoyukim.vscode-mermaid-editor",
				// "dbaeumer.vscode-eslint",
				// "vscjava.vscode-java-pack",
				"sonarsource.sonarlint-vscode",
				"redhat.fabric8-analytics",
				"ms-ossdata.vscode-postgresql",
				"github.vscode-github-actions"
			]
		}
	}
}
