{
	"name": "EbMS 2.19",
	"image": "mcr.microsoft.com/devcontainers/base:noble",
	"mounts": [
		"type=bind,source=${localEnv:HOME}${localEnv:USERPROFILE}/.ssh/,target=/home/vscode/.ssh,readonly"
	],
	"features": {
		"ghcr.io/devcontainers/features/docker-in-docker:2": {},
		"ghcr.io/devcontainers/features/node:1": {},
		"ghcr.io/devcontainers/features/java:1": {
			"installMaven": true,
			"mavenVersion": "3.9.8",
			"version": "11",
			"additionalVersions": "21.0.7-ms"
		},
		"ghcr.io/devcontainers-extra/features/apt-packages:1": {
			"packages": "libxtst6,libxi6,libxrender1"
		}
	},
	"forwardPorts": [3000,5432,8080],
    "customizations": {
        "vscode": {
            "settings": {
				"sonarlint.ls.javaHome": "/usr/local/sdkman/candidates/java/21.0.7-ms",
            },
            "extensions": [
                // "ms-azuretools.vscode-docker",
				"donjayamanne.githistory",
                "mhutchie.git-graph",
				"humao.rest-client",
				"qcz.text-power-tools",
				"berublan.vscode-log-viewer",
                // "dbaeumer.vscode-eslint",
				// "vscjava.vscode-java-pack",
				"sonarsource.sonarlint-vscode",
				"redhat.fabric8-analytics",
				"ms-ossdata.vscode-postgresql"
            ]
        }
    }
}
